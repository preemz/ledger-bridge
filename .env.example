DATABASE_URL=postgres://localhost:5432/ledger_bridge
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Temporal
TEMPORAL_ENABLED=true
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ledger-migration

# The simulated legacy ERP
LEGACY_API_BASE=http://127.0.0.1:8000/legacy-api/v1
LEGACY_API_TOKEN=legacy-dev-token
# Dev default only. The inbound webhook endpoint verifies this HMAC before it trusts a
# delivery, so in any shared or deployed environment it must be a real secret: the value
# below is in the repository and is therefore public.
LEGACY_WEBHOOK_SECRET=legacy-webhook-secret

# Failure injection, used to prove retry behaviour on camera
LEGACY_FLAKE_RATE=0.08
LEGACY_RATE_LIMIT_PER_SECOND=5
